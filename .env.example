# Generate independent long random values for RUNNER_TOKEN, POSTGRES_PASSWORD and JWT_SECRET.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
RUNNER_TOKEN=replace-with-a-long-random-runner-secret
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-a-long-random-jwt-signing-secret

# Redis is used for shared API rate-limit counters in Docker Compose.
REDIS_URL=redis://redis:6379/0

# Optional: set METRICS_TOKEN to enable bearer-protected Prometheus scraping.
# METRICS_TOKEN=replace-with-a-long-random-metrics-token

# Local AI reviews use Ollama by default (no paid API calls).
AI_REVIEW_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_REVIEW_MODEL=qwen3.5:4b

# Optional alternative: OpenAI requires a separately billed API key.
# AI_REVIEW_PROVIDER=openai
# OPENAI_API_KEY=replace-with-your-openai-api-key
# OPENAI_REVIEW_MODEL=gpt-5.6-terra

# Local non-Docker development can use SQLite:
# DATABASE_URL=sqlite:///./data/evaluations.db
