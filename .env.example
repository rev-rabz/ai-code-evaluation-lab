# Generate independent long random secrets for all three values.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
RUNNER_TOKEN=replace-with-a-long-random-runner-secret
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-a-long-random-jwt-signing-secret

# Local non-Docker development can use SQLite:
# DATABASE_URL=sqlite:///./data/evaluations.db

# Optional AI code reviews. Leave unset to keep AI reviews disabled.
# The review endpoint sends source code to OpenAI only after an authenticated user explicitly requests it.
# OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_REVIEW_MODEL=gpt-5.6-terra

REDIS_URL=redis://redis:6379/0
# Optional: set METRICS_TOKEN to enable bearer-protected Prometheus scraping.
